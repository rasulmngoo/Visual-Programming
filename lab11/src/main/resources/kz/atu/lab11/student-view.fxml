<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="520.0" prefWidth="760.0" spacing="10.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kz.atu.lab11.controller.StudentController">
   <padding>
      <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <Label text="Поиск по ФИО:" />
            <TextField fx:id="txtSearch" promptText="Введите часть имени" HBox.hgrow="ALWAYS" />
            <Label text="Группа:" />
            <ComboBox fx:id="cmbGroupFilter" prefWidth="130.0" />
         </children>
      </HBox>
      <TableView fx:id="tableStudents" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colName" prefWidth="360.0" text="ФИО" />
            <TableColumn fx:id="colGroup" prefWidth="170.0" text="Группа" />
            <TableColumn fx:id="colGpa" prefWidth="150.0" text="GPA" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <TextField fx:id="txtName" promptText="ФИО" HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtGroup" prefWidth="110.0" promptText="Группа" />
            <TextField fx:id="txtGpa" prefWidth="90.0" promptText="GPA (0–4)" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <Button onAction="#onAdd" text="Добавить" />
            <Button onAction="#onUpdate" text="Изменить" />
            <Button onAction="#onDelete" text="Удалить" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblAvg" text="Средний GPA: 0.00" />
            <Label fx:id="lblCount" text="Найдено студентов: 0" />
         </children>
      </HBox>
   </children>
</VBox>
