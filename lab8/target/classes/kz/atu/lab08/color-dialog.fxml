<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kz.atu.lab08.ColorDialogController" spacing="14" prefWidth="300">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Выберите цвет текста таблицы:"/>
    <ColorPicker fx:id="colorPicker" maxWidth="Infinity"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Применить" defaultButton="true" onAction="#onApply"/>
        <Button text="Отмена" cancelButton="true" onAction="#onCancel"/>
    </HBox>
</VBox>
