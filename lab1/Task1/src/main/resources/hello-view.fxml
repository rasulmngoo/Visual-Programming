<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="HelloController"
            prefHeight="300.0" prefWidth="400.0">
    <children>
        <VBox alignment="CENTER" spacing="15.0"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets top="30.0" bottom="30.0" left="20.0" right="20.0"/>
            </padding>
            <children>
                <Label fx:id="lblFio" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="ФИО"/>
                <Label fx:id="lblGroup" style="-fx-font-size: 16px;" text="Группа"/>
                <Label fx:id="lblSpeciality" style="-fx-font-size: 16px;" text="Специальность"/>
            </children>
        </VBox>
    </children>
</AnchorPane>
