<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="HelloController"
      alignment="TOP_CENTER" spacing="15.0" prefHeight="480.0" prefWidth="450.0">
    <padding>
        <Insets top="25.0" bottom="25.0" left="25.0" right="25.0"/>
    </padding>
    <children>
        <GridPane hgap="10.0" vgap="12.0">
            <children>
                <Label text="ФИО:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtFio" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Город:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Пол:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <HBox spacing="10.0" GridPane.rowIndex="2" GridPane.columnIndex="1">
                    <children>
                        <RadioButton fx:id="rbMale" text="Мужской"/>
                        <RadioButton fx:id="rbFemale" text="Женский"/>
                    </children>
                </HBox>

                <Label text="Курс:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbCourse" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </children>
        </GridPane>

        <VBox spacing="8.0" alignment="CENTER_LEFT">
            <children>
                <Label text="Дополнительные параметры:"/>
                <CheckBox fx:id="chkNewsletter" text="Подписка на рассылку новостей"/>
                <CheckBox fx:id="chkSms" text="SMS-уведомления"/>
            </children>
        </VBox>

        <Button text="Сформировать анкету" onAction="#onSubmitClick"/>
        <Label fx:id="lblResult" wrapText="true" style="-fx-font-size: 13px;"/>
    </children>
</VBox>
