<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="HelloController"
      alignment="CENTER" spacing="20.0" prefHeight="250.0" prefWidth="400.0">
    <padding>
        <Insets top="25.0" bottom="25.0" left="25.0" right="25.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="Год рождения:"/>
                <TextField fx:id="txtBirthYear"/>
            </children>
        </HBox>
        <Button text="Рассчитать возраст" onAction="#onCalculateClick"/>
        <Label fx:id="lblResult" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    </children>
</VBox>
