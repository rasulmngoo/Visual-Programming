<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="com.example.lab4.HelloController" fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER_LEFT" fx:id="topBar" spacing="10">
            <padding>
                <Insets bottom="10" left="15" right="15" top="10"/>
            </padding>
            <Label text="Панель управления студентами"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAdd" onAction="#onSaveClick" text="Добавить"/>
            <Button fx:id="btnClear" onAction="#onClearClick" text="Очистить"/>
        </HBox>
    </top>
    <left>
        <VBox fx:id="navigationBox" prefWidth="160" spacing="8">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10"/>
            </padding>
            <Button maxWidth="Infinity" text="Студенты"/>
            <Button maxWidth="Infinity" text="Группы"/>
            <Button maxWidth="Infinity" text="Настройки"/>
        </VBox>
    </left>
    <center>
        <VBox fx:id="contentBox" spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10"/>
            </padding>
            <GridPane fx:id="formGrid" hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="80" prefWidth="100"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="150" prefWidth="300"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="30" vgrow="SOMETIMES"/>
                    <RowConstraints minHeight="30" vgrow="SOMETIMES"/>
                    <RowConstraints minHeight="30" vgrow="SOMETIMES"/>
                    <RowConstraints minHeight="30" vgrow="SOMETIMES"/>
                </rowConstraints>
                <children>
                    <Label GridPane.columnIndex="0" GridPane.rowIndex="0" text="ФИО:"/>
                    <TextField GridPane.columnIndex="1" GridPane.rowIndex="0" fx:id="txtFullName" maxWidth="Infinity"/>

                    <Label GridPane.columnIndex="0" GridPane.rowIndex="1" text="Группа:"/>
                    <TextField GridPane.columnIndex="1" GridPane.rowIndex="1" fx:id="txtGroup" maxWidth="Infinity"/>

                    <Label GridPane.columnIndex="0" GridPane.rowIndex="2" text="Курс:"/>
                    <ComboBox GridPane.columnIndex="1" GridPane.rowIndex="2" fx:id="cmbCourse" maxWidth="Infinity"/>

                    <Button GridPane.columnIndex="1" GridPane.rowIndex="3" fx:id="btnSave" onAction="#onSaveClick" text="Сохранить"/>
                </children>
            </GridPane>
            <TableView VBox.vgrow="ALWAYS" fx:id="tblStudents">
                <columns>
                    <TableColumn fx:id="colName" prefWidth="250.0" text="ФИО"/>
                    <TableColumn fx:id="colGroup" prefWidth="150.0" text="Группа"/>
                    <TableColumn fx:id="colCourse" prefWidth="120.0" text="Курс"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox>
            <padding>
                <Insets bottom="5" left="10" right="5" top="5"/>
            </padding>
            <Label fx:id="lblStatus" text="Статус: приложение готово"/>
        </HBox>
    </bottom>
</BorderPane>