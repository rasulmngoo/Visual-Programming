<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="com.example.lab3.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="lblOperation" text="Операция: -" style="-fx-font-size: 14px; -fx-font-weight: bold;" />

    <TextField fx:id="txtNumber1" promptText="Введите первое число" />
    <TextField fx:id="txtNumber2" promptText="Введите второе число" />

    <!-- Первый ряд кнопок -->
    <HBox alignment="CENTER" spacing="10.0">
        <Button text="+" onAction="#onOperation" onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited" prefWidth="50" />
        <Button text="-" onAction="#onOperation" onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited" prefWidth="50" />
        <Button text="*" onAction="#onOperation" onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited" prefWidth="50" />
        <Button text="/" onAction="#onOperation" onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited" prefWidth="50" />
    </HBox>

    <!-- Второй ряд кнопок (Кнопка среднего арифметического) -->
    <HBox alignment="CENTER" spacing="10.0">
        <Button text="Среднее" onAction="#onOperation" onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited" prefWidth="115" />
        <Button text="Очистить" onAction="#onClearClick" prefWidth="115" />
    </HBox>

    <Button text="Выход" onAction="#onExitClick" prefWidth="240" />

    <Label fx:id="lblResult" text="Результат: 0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
</VBox>