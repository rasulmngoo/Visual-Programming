<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab.RegistrationController"
            prefWidth="900" prefHeight="650" styleClass="root">
    <top>
        <VBox spacing="5" styleClass="header">
            <padding><Insets top="18" right="22" bottom="15" left="22"/></padding>
            <Label text="Регистрация на экзамен" styleClass="title"/>
            <Label text="Вариант 19 · Проверка суммы · 5000 ₸ за один экзамен" styleClass="subtitle"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="12" styleClass="content-panel">
            <padding><Insets top="18" right="24" bottom="20" left="24"/></padding>
            <GridPane hgap="16" vgap="7" styleClass="form-grid">
                <columnConstraints>
                    <ColumnConstraints minWidth="150" prefWidth="170"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="ФИО:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtName" promptText="Введите ФИО" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label fx:id="lblNameError" styleClass="error-label" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtEmail" promptText="example@mail.com" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label fx:id="lblEmailError" styleClass="error-label" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Возраст:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txtAge" promptText="От 16 до 100" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Label fx:id="lblAgeError" styleClass="error-label" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Предмет экзамена:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbSubject" promptText="Выберите предмет" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                <Label fx:id="lblSubjectError" styleClass="error-label" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                <Label text="Количество экзаменов:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCount" promptText="От 1 до 5" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                <Label fx:id="lblCountError" styleClass="error-label" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                <Label text="Сумма к оплате (₸):" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                <TextField fx:id="txtSum" promptText="Например, 5000" GridPane.rowIndex="10" GridPane.columnIndex="1"/>
                <Label fx:id="lblSumError" styleClass="error-label" GridPane.rowIndex="11" GridPane.columnIndex="1"/>

                <CheckBox fx:id="chkConsent" text="Согласен на обработку данных" GridPane.rowIndex="12" GridPane.columnIndex="1"/>
                <Label fx:id="lblConsentError" styleClass="error-label" GridPane.rowIndex="13" GridPane.columnIndex="1"/>
            </GridPane>
            <HBox spacing="12" styleClass="actions">
                <Button fx:id="btnRegister" text="Зарегистрировать" onAction="#onRegister" styleClass="primary-button"/>
                <Button text="Очистить" onAction="#onClear"/>
            </HBox>
            <Label fx:id="lblStatus" text="Стоимость одного экзамена — 5000 ₸" styleClass="status"/>
            <Separator/>
            <HBox alignment="CENTER_LEFT" spacing="8"><Label text="▦" styleClass="section-icon"/><Label text="Зарегистрированные участники" styleClass="section-title"/></HBox>
            <TableView fx:id="tableParticipants" VBox.vgrow="ALWAYS" prefHeight="220">
                <columns>
                    <TableColumn fx:id="colName" text="ФИО" prefWidth="170"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="160"/>
                    <TableColumn fx:id="colAge" text="Возраст" prefWidth="65"/>
                    <TableColumn fx:id="colSubject" text="Предмет" prefWidth="130"/>
                    <TableColumn fx:id="colCount" text="Экзамены" prefWidth="80"/>
                    <TableColumn fx:id="colSum" text="Сумма ₸" prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>